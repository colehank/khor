---
import NetworkDiagram from './concepts/NetworkDiagram.astro';
import CapabilityScene from './concepts/CapabilityScene.astro';
import '../styles/product-tour.css';
import L from './Localized.astro';
interface Props {scene:'network'|'work'|'agent';pinned?:boolean;}
const {scene,pinned=false}=Astro.props;
---
<div class:list={['product-tour',{'story-tour':pinned}]} data-product-tour>
  {scene==='network'&&<section class="tour-section tour-network" id="connect" aria-labelledby="connect-title">
    <div class="tour-copy">
      <h2 id="connect-title"><L en="Stay connected" zh="保持连接"/></h2>
      <p><L en="Your devices form their own network. Built on iroh, Khor lets online devices relay for each other. When a device switches networks, Khor Relay provides a path while it reconnects." zh="你的设备，自成一张网。Khor 基于 iroh 建立去中心化连接，让在线设备可以彼此中继。设备切换网络时，Khor Relay 提供过渡路径，协助重新建联。"/></p>
    </div>
    <NetworkDiagram />
  </section>}
  {scene==='work'&&<section class="tour-section tour-capabilities" id="work" aria-labelledby="work-title">
    <span class="tour-anchor" id="sessions" aria-hidden="true"></span><span class="tour-anchor" id="terminal" aria-hidden="true"></span>
    <div class="tour-copy">
      <h2 id="work-title"><L en="Continue anywhere" zh="随地继续"/></h2>
      <p><L en="Pick up an agent or terminal session running on another device. Preview and edit remote files, track changes with Git, and open local web pages through the device they run on." zh="从手边的设备，接续另一台设备上的智能体或终端会话。预览和编辑远端文件，用 Git 追踪改动，也能通过目标设备的网络，打开运行在它本机的网页。"/></p>
    </div>
    <CapabilityScene mode="work" />
  </section>}
  {scene==='agent'&&<section class="tour-section tour-capabilities" id="khor-agent" aria-labelledby="agent-title">
    <span class="tour-anchor" id="resources" aria-hidden="true"></span>
    <div class="tour-copy">
      <h2 id="agent-title"><L en={"Let Khor\u00a0Agent take over"} zh={"交给 Khor\u00a0Agent"}/></h2>
      <p><L en="Tell Khor Agent what you want to accomplish. It coordinates agents across your devices and sends the result back to the device you're using." zh="告诉 Khor Agent 你想要什么结果。它会调度不同设备上的智能体，协调分工，再把结果送回你当前使用的设备。"/></p>
    </div>
    <CapabilityScene mode="agent" />
  </section>}
</div>
