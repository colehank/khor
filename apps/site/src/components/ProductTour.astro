---
import NetworkDiagram from './concepts/NetworkDiagram.astro';
import CapabilityScene from './concepts/CapabilityScene.astro';
import '../styles/product-tour.css';
---
<div class="product-tour" data-product-tour lang="en">
  <section class="tour-section tour-network" id="connect" aria-labelledby="connect-title">
    <div class="tour-copy"><h2 id="connect-title">Your devices, <span>your net</span></h2><p>A private peer-to-peer network, built around your devices</p></div>
    <NetworkDiagram />
  </section>
  <section class="tour-section tour-capabilities" id="work" aria-labelledby="work-title">
    <span class="tour-anchor" id="sessions" aria-hidden="true"></span><span class="tour-anchor" id="terminal" aria-hidden="true"></span>
    <div class="tour-copy"><h2 id="work-title">Work across the net</h2><p>Keep your task moving, from any device</p></div>
    <CapabilityScene mode="work" />
  </section>
  <section class="tour-section tour-capabilities" id="khor-agent" aria-labelledby="agent-title">
    <span class="tour-anchor" id="resources" aria-hidden="true"></span>
    <div class="tour-copy"><h2 id="agent-title">Khor Agent</h2><p>Give Khor the task, get the result</p></div>
    <CapabilityScene mode="agent" />
  </section>
</div>
<script>
  import {mountProductTour} from '../scripts/product-tour';
  mountProductTour();
</script>
