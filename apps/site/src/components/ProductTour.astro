---
import PeerDiagram from './concepts/PeerDiagram.astro';
import AgentDiagram from './concepts/AgentDiagram.astro';
import TerminalDiagram from './concepts/TerminalDiagram.astro';
import '../styles/product-tour.css';
---
<div class="product-tour" data-product-tour lang="en">
  <section class="tour-section" id="connect" aria-labelledby="connect-title">
    <div class="tour-copy">
      <h2 id="connect-title">Your computer<br/><span>From your phone</span></h2>
      <p>Reach files and localhost web apps on another device through a peer-to-peer connection</p>
    </div>
    <PeerDiagram />
  </section>
  <section class="tour-section" id="khor-agent" aria-labelledby="agent-title">
    <div class="tour-copy">
      <h2 id="agent-title">Khor Agent<br/><span>Put your agents to work</span></h2>
      <p>Give Khor a task and let it find your agents, delegate the work, and bring the results back to you</p>
    </div>
    <AgentDiagram />
  </section>
  <section class="tour-section" id="terminal" aria-labelledby="terminal-title">
    <div class="tour-copy">
      <h2 id="terminal-title">Same terminal<br/><span>Any device</span></h2>
      <p>Your shell keeps running on its host, while you pick up the same session from your desktop or phone</p>
    </div>
    <TerminalDiagram />
  </section>
</div>
<script>
  import {mountProductTour} from '../scripts/product-tour';
  mountProductTour();
</script>
