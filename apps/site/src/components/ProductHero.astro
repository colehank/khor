---
import desktop from "../assets/product/desktop.webp";
import desktopDark from "../assets/product/desktop-dark.webp";
import desktopZh from '../assets/product/desktop-zh.webp';
import desktopZhDark from '../assets/product/desktop-zh-dark.webp';
import fog from "../assets/product/fog.webp";
import {sitePath} from '../paths';
import ProductActions from './ProductActions.astro';
import ProductInstallations from './ProductInstallations.astro';
import {fogOptions} from "../scripts/fog-options";
import L from './Localized.astro';
import {localizedAttrs} from '../i18n';
---
<section class="product-hero" id="khor-hero" aria-labelledby="product-title" data-product-hero style={`--fog-base:#${fogOptions.baseColor.toString(16)}`}>
  <div class="hero-ground" data-fog aria-hidden="true"><img class="fog-fallback" src={fog.src} alt="" width={fog.width} height={fog.height} loading="eager" /></div>
  <div class="product-main">
  <div class="product-copy">
    <h1 id="product-title">Khor</h1>
    <p class="product-description"><span class="product-promise"><L en="A workspace for your devices and agents" zh="跨设备与智能体工作台"/></span> <span class="product-detail"><L en="Continue sessions, edit files, and open web apps running on your other devices. You can even hand it all off to Khor Agent." zh="从手边的设备，继续远端会话、编辑文件、打开其他设备上运行的网页。甚至，把这一切交给 Khor Agent。"/></span></p>
    <ProductActions prefix="hero" />
  </div>
<section class="product-showcase" id="product" {...localizedAttrs({'aria-label':['Khor desktop interface','Khor 桌面界面']})} data-product-showcase>
    <div class="macos-window">
      <div class="desktop-preview" data-desktop-preview>
        <picture class="desktop-poster" data-script-poster>
          <source data-theme-source media="(prefers-color-scheme: dark)" {...localizedAttrs({srcset:[desktopDark.src,desktopZhDark.src]},true)}/>
          <img width={desktop.width} height={desktop.height} {...localizedAttrs({src:[desktop.src,desktopZh.src],alt:['Khor desktop with built-in conversations, remote files, and Cursor, Codex, Claude and shell sessions','Khor 桌面界面，包含内置对话、远程文件和多种智能体会话']},true)} loading="eager" fetchpriority="high"/>
          <script is:inline>
            {const picture=document.currentScript.parentElement,index=document.documentElement.dataset.locale==='zh'?1:0;for(const node of picture.querySelectorAll('[data-localized-attrs]'))for(const [name,pair] of Object.entries(JSON.parse(node.getAttribute('data-localized-attrs'))))node.setAttribute(name,pair[index]);picture.querySelector('[data-theme-source]').media=document.documentElement.dataset.theme==='dark'?'all':'not all';}
          </script>
        </picture>
        <noscript><picture class="desktop-poster"><source media="(prefers-color-scheme: dark)" srcset={desktopDark.src}/><img src={desktop.src} width={desktop.width} height={desktop.height} alt="Khor desktop"/></picture></noscript>
        <div class="desktop-stage" data-desktop-stage><iframe {...localizedAttrs({title:['Try the Khor desktop interface','体验 Khor 桌面界面']})} data-desktop-demo data-src={sitePath("/experience/app/index.html?scene=content&hero=1")} sandbox="allow-scripts allow-same-origin allow-forms" referrerpolicy="same-origin"></iframe></div>
      </div>
    </div>
</section>
  </div>
  <ProductInstallations prefix="hero" />
</section>
<script>
  import {mountDesktopPreview} from "../scripts/product";
  import {mountFog} from "../scripts/fog";
  mountDesktopPreview();mountFog();
</script>
