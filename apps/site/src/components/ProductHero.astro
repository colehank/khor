---
import desktop from "../assets/product/desktop.webp";
import desktopDark from "../assets/product/desktop-dark.webp";
import icon from "../../../gui/src-tauri/icons/src/mandala-glass.svg";
---
<section class="product-hero" aria-labelledby="product-title" data-product-hero>
  <div class="product-copy">
    <h1 id="product-title"><img src={icon.src} alt="" width="56" height="56" />Khor</h1>
    <p class="product-tagline">Work across your devices and harnesses.</p>
    <p class="product-description">在一处访问各台设备上的智能体、文件和网页。</p>
    <div class="product-actions">
      <a class="product-download" href="/download/" data-device-download><span data-download-label>下载 Khor</span><span aria-hidden="true">↓</span></a>
      <a class="product-docs" href="/docs/">阅读文档 <span aria-hidden="true">↗</span></a>
    </div>
    <p class="product-availability" data-download-note>macOS App · Linux / macOS CLI</p>
    <a class="product-learn" href="#story">了解 Khor <span aria-hidden="true">⌄</span></a>
  </div>
  <div class="product-desktop">
    <div class="macos-window">
      <div class="desktop-preview" data-desktop-preview>
        <picture class="desktop-poster"><source media="(prefers-color-scheme: dark)" srcset={desktopDark.src} /><img src={desktop.src} width={desktop.width} height={desktop.height} alt="Khor 完整桌面界面：Claude、Cursor、Codex、Khor 和 Shell 会话、对话与远程资源窗格" loading="eager" fetchpriority="high" /></picture>
        <div class="desktop-stage" data-desktop-stage><iframe title="试用 Khor 桌面界面" data-desktop-demo data-src="/experience/app/index.html?scene=content&amp;hero=1" sandbox="allow-scripts allow-same-origin allow-forms" referrerpolicy="same-origin"></iframe></div>
      </div>
    </div>
    <p class="desktop-caption">试着发条消息。</p>
  </div>
</section>
<script>
  import {mountDesktopPreview} from "../scripts/product";
  mountDesktopPreview();
</script>
