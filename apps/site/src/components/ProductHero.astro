---
import desktop from "../assets/product/desktop.webp";
import desktopDark from "../assets/product/desktop-dark.webp";
import fog from "../assets/product/fog.webp";
import {sitePath} from '../paths';
import ProductActions from './ProductActions.astro';
import ProductInstallations from './ProductInstallations.astro';
import {fogOptions} from "../scripts/fog-options";
---
<section class="product-hero" id="khor-hero" aria-labelledby="product-title" data-product-hero style={`--fog-base:#${fogOptions.baseColor.toString(16)}`}>
  <div class="hero-ground" data-fog aria-hidden="true"><img class="fog-fallback" src={fog.src} alt="" width={fog.width} height={fog.height} loading="eager" /></div>
  <div class="product-main">
  <div class="product-copy">
    <h1 id="product-title">Khor</h1>
    <p class="product-description" lang="en"><span class="product-promise">Work across your devices and agents</span> <span class="product-detail">Access agents, edit files, track changes, and connect to web apps from any device, <span class="keep-together">peer to peer</span></span></p>
    <ProductActions />
  </div>
<section class="product-showcase" id="product" aria-label="Khor desktop interface" data-product-showcase>
    <div class="macos-window">
      <div class="desktop-preview" data-desktop-preview>
        <picture class="desktop-poster"><source media="(prefers-color-scheme: dark)" srcset={desktopDark.src} /><img src={desktop.src} width={desktop.width} height={desktop.height} alt="Khor desktop with built-in conversations, remote files, and Cursor, Codex, Claude and shell sessions" loading="eager" fetchpriority="high" /></picture>
        <div class="desktop-stage" data-desktop-stage><iframe title="Try the Khor desktop interface" data-desktop-demo data-src={sitePath("/experience/app/index.html?scene=content&hero=1")} sandbox="allow-scripts allow-same-origin allow-forms" referrerpolicy="same-origin"></iframe></div>
      </div>
    </div>
</section>
  </div>
  <ProductInstallations prefix="hero" />
</section>
<script>
  import {mountDesktopPreview} from "../scripts/product";
  import {mountFog} from "../scripts/fog";
  mountDesktopPreview();mountFog();
</script>
