---
import desktop from "../assets/product/desktop.webp";
import desktopDark from "../assets/product/desktop-dark.webp";
import fog from "../assets/product/fog.webp";
import {supportedDevices} from "../../../gui/dev/site/identity-marks";
import {release} from '../releases';
import {fogOptions} from "../scripts/fog-options";
const platforms=supportedDevices.map(platform=>{
  const id=platform.name.toLowerCase();
  const available=release.downloads.some(item=>item.platform.toLowerCase().startsWith(id));
  return {...platform,id,available};
});
---
<section class="product-hero" id="khor-hero" aria-labelledby="product-title" data-product-hero style={`--fog-base:#${fogOptions.baseColor.toString(16)}`}>
  <div class="hero-ground" data-fog aria-hidden="true"><img class="fog-fallback" src={fog.src} alt="" width={fog.width} height={fog.height} loading="eager" /></div>
  <div class="product-main">
  <div class="product-copy">
    <h1 id="product-title">Khor</h1>
    <p class="product-description" lang="en">Work across your devices and agents. Edit files, track changes, and use your web apps. From any device, peer to peer. Efficient, secure, and delightful.</p>
    <div class="product-actions">
      <a class="product-download" href="/download/" data-device-download>下载</a>
      <a class="product-docs" href="/docs/">文档</a>
    </div>
  </div>
<section class="product-showcase" id="product" aria-label="Khor 桌面界面" data-product-showcase>
    <div class="macos-window">
      <div class="desktop-preview" data-desktop-preview>
        <picture class="desktop-poster"><source media="(prefers-color-scheme: dark)" srcset={desktopDark.src} /><img src={desktop.src} width={desktop.width} height={desktop.height} alt="Khor 完整桌面界面：Khor 内置对话、远程资源窗格，以及 Cursor、Codex、Claude 和 Shell 会话" loading="eager" fetchpriority="high" /></picture>
        <div class="desktop-stage" data-desktop-stage><iframe title="试用 Khor 桌面界面" data-desktop-demo data-src="/experience/app/index.html?scene=content&amp;hero=1" sandbox="allow-scripts allow-same-origin allow-forms" referrerpolicy="same-origin"></iframe></div>
      </div>
    </div>
</section>
  </div>
  <nav class="product-platforms" aria-label="安装方式">
    {platforms.map(platform=>platform.available?
      <a class="platform-option" href={`/download/?platform=${platform.id}`} title={platform.id==='linux'?'Linux CLI':'macOS App · CLI'} aria-label={platform.id==='linux'?'安装 Linux CLI':'安装 macOS App 或 CLI'}><span class="platform-icon" aria-hidden="true" set:html={platform.svg}/><span>{platform.name}</span></a>:
      <button class="platform-option" type="button" aria-disabled="true" aria-label={platform.name} aria-describedby={`platform-${platform.id}-soon`}><span class="platform-icon" aria-hidden="true" set:html={platform.svg}/><span>{platform.name}</span><span class="platform-tooltip" role="tooltip" id={`platform-${platform.id}-soon`}>Coming soon</span></button>
    )}
  </nav>
</section>
<script>
  import {mountDesktopPreview} from "../scripts/product";
  import {mountFog} from "../scripts/fog";
  mountDesktopPreview();mountFog();
</script>
