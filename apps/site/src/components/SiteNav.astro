---
import {sitePath} from "../paths";
import github from '../assets/github.svg?raw';
import {REPO} from '../site';
import BrandIcon from './BrandIcon.astro';
import L from './Localized.astro';
import {localizedAttrs} from '../i18n';
import appearance from '../assets/navigation/appearance.svg?raw';
import language from '../assets/navigation/language.svg?raw';
import docs from '../assets/navigation/docs.svg?raw';
import download from '../assets/navigation/download.svg?raw';
interface Props { home?:boolean; current?:'docs'|'download'; }
const {home=false,current}=Astro.props;
const links=[
  {id:'docs',label:'Docs',zh:'文档',href:sitePath('/docs/'),icon:docs},
  {id:'download',label:'Download',zh:'下载',href:sitePath('/download/'),icon:download},
] as const;
---
<header class="story-nav" data-over-hero={home?true:undefined}>
  <a class="site-brand" href={sitePath(home?'#khor-hero':'/')} {...localizedAttrs({'aria-label':['Khor home','Khor 首页']})}><BrandIcon prefix="nav-brand" size={32} variant="navigation"/><span class="site-brand-name">Khor</span></a>
  <nav {...localizedAttrs({'aria-label':['Main navigation','主导航']})}>
    {links.map(({id,label,zh,href,icon})=><a class={`nav-${id}`} {href} aria-current={current===id?'page':undefined} {...localizedAttrs({'aria-label':[label,zh]})}>
      <Fragment set:html={icon}/><span class="nav-tooltip" aria-hidden="true"><L en={label} zh={zh}/></span>
    </a>)}
    <a class="nav-github" href={REPO} {...localizedAttrs({'aria-label':['Khor on GitHub','Khor 的 GitHub 仓库']})}><Fragment set:html={github}/><span class="nav-tooltip" aria-hidden="true">GitHub</span></a>
    <button class="nav-preference-trigger" type="button" data-theme-toggle aria-pressed="false" {...localizedAttrs({'aria-label':['Toggle appearance','切换明暗']})}><Fragment set:html={appearance}/><span class="nav-tooltip" aria-hidden="true"><L en="Appearance" zh="明暗"/></span></button>
    <label class="nav-language"><Fragment set:html={language}/><span class="nav-tooltip" aria-hidden="true"><L en="Language" zh="语言"/></span><select data-language-select {...localizedAttrs({'aria-label':['Language','语言']})}>
      <option value="system" {...localizedAttrs({textContent:['Follow system','跟随系统']})}>Follow system</option><option value="en">English</option><option value="zh">简体中文</option>
    </select></label>
  </nav>
</header>
<script>
  import {mountPreferenceControls} from '../scripts/preference-controls';
  mountPreferenceControls();
</script>
