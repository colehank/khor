---
import NetworkGraph from './NetworkGraph.astro';
import ConceptMark from './ConceptMark.astro';
import {supportedHarnesses,capabilityMarks} from '../../../../gui/dev/site/identity-marks';
import {workPhases,agentPhases,taskPackets,taskSessions} from './capability-data';
import {capabilityGeometry} from '../../scripts/capability-geometry';
import {taskState} from '../../scripts/task-state';
import '../../styles/capability-scene.css';
interface Props {mode:'work'|'agent'}
const {mode}=Astro.props,isAgent=mode==='agent';
const phases=isAgent?agentPhases:workPhases,initial=phases[phases.length-1];
const initialState=taskState(phases,phases.length-1,initial.duration);
const {nodes,userPath}=capabilityGeometry(false);
const marks=Object.fromEntries(supportedHarnesses.map(mark=>[mark.name,mark.svg]));
const glyph=(name:string)=>marks[name]??capabilityMarks[name];
const recipients=isAgent?['mac','linux','khor','you'] as const:['mac','linux','windows','phone'] as const;
const description=isAgent?'You stay outside KhorNet and delegate a task to its boundary Khor Agent. Khor sends a dialogue request to Claude Code on the workstation. Claude produces a local file. Khor instructs Codex on Server and transfers the file directly from the workstation to Server. Once both inputs arrive, Codex runs and starts a local Web service. Khor returns the result and Web link to you. Sessions stay on their execution hosts.':'From a laptop, you send a dialogue request to Claude Code on a remote workstation. Claude runs there and produces a local file. You send the next request to Codex on Server; the file transfers directly from the workstation to Server. Codex runs only after both inputs arrive and starts a Web service on Server. You switch to Mobile, continue the same task and view the page served by Server. The laptop and Mobile are access devices; sessions stay on their execution hosts.';
---
<figure class:list={['concept','concept-network','task-scene',`task-${mode}`]} data-concept={mode} data-task-stage="done" data-task-complete="true" data-task-ready="true" data-task-accepted="true" data-task-result="true" data-net-connection="p2p" style="--net-build:1">
  <p class="task-goal">Task</p>
  <NetworkGraph prefix={mode} infrastructure={false} externalUser={isAgent} title={isAgent?'Khor coordinates sessions across devices and returns the result':'Continue the same task through remote sessions, files and Web'} {description}>
    <Fragment slot="clearances">
      <rect data-task-user-cut x={isAgent?nodes.you.x-36:nodes.phone.x-36} y={isAgent?nodes.you.y-16:nodes.phone.y+49} width="72" height="33" fill="black"/>
      {taskSessions.map(({device})=><rect data-task-session-cut={device} x={nodes[device].x-70} y={nodes[device].y+49} width="140" height="33" fill="black"/>)}
    </Fragment>
    <g slot="routes" class="task-operation" aria-hidden="true">
      {isAgent&&<path class="task-user-link" data-task-user-link d={userPath}/>}
      <path class="task-route" data-task-route d="M0 0"/>
      <g class="task-packet" data-task-packet opacity="0">
        <circle r="14"/>
        {taskPackets.map(name=><g data-task-payload={name}><svg x="-9" y="-9" width="18" height="18"><ConceptMark svg={glyph(name)} x={0} y={0} size={18} prefix={`${mode}-packet-${name}`}/></svg></g>)}
      </g>
    </g>
    <g slot="activity" class="task-activity">
      {taskSessions.map(({device,name,mark})=><g data-task-session-at={device} transform={`translate(${nodes[device].x} ${nodes[device].y})`}>
        <g class="task-session" data-task-session={device} data-session-state="done">
          <circle class="task-progress-track" r="43"/>
          <circle class="task-progress" data-task-progress r="43" pathLength="1" transform="rotate(-90)"/>
          <g class="task-badge task-session-mark" transform="translate(28 -28)">
            <circle r="15"/>
            <svg x="-10" y="-10" width="20" height="20"><ConceptMark svg={glyph(mark)} x={0} y={0} size={20} prefix={`${mode}-${device}-session`}/></svg>
          </g>
          <text class="task-runtime-label" x="0" y="72" text-anchor="middle">{name}</text>
        </g>
      </g>)}
      {isAgent&&<circle class="task-router-ring" data-task-router-ring cx={nodes.khor.x} cy={nodes.khor.y} r="27"/>}
      {isAgent?
        <g class="task-outsider" data-task-user transform={`translate(${nodes.you.x} ${nodes.you.y})`}><circle r="28"/><text x="0" y="6" text-anchor="middle">You</text></g>:
        <g class="task-user" data-task-user transform={`translate(${nodes.phone.x} ${nodes.phone.y+70})`}><circle cx="-22" cy="-5" r="3"/><text x="-12" y="0">You</text></g>
      }
      {recipients.map(device=><g data-task-receipt-at={device} transform={`translate(${nodes[device].x} ${nodes[device].y})`}>
        <g class="task-badge task-receipt" data-task-receipt={device} data-has-receipt={String(!!initialState.receipts[device])} transform={device==='phone'?'translate(28 -28)':device==='you'?'translate(23 23)':device==='khor'?'translate(-22 22)':device==='linux'?'translate(-28 28)':'translate(28 28)'}>
          <circle r="15"/>
          {taskPackets.map(name=><g data-receipt-payload={name} data-visible={String(name===initialState.receipts[device])}><svg x="-10" y="-10" width="20" height="20"><ConceptMark svg={glyph(name)} x={0} y={0} size={20} prefix={`${mode}-${device}-received-${name}`}/></svg></g>)}
          {(device==='mac'||device==='linux')&&<text class="task-resource-label" data-task-resource-label x={device==='linux'?-22:22} y="6" text-anchor={device==='linux'?'end':'start'}>{device==='mac'?'File':'Web'}</text>}
        </g>
      </g>)}
    </g>
  </NetworkGraph>
  <figcaption class="task-caption">
    <div><span class="task-caption-check" aria-hidden="true"><ConceptMark svg={glyph('check')} x={0} y={0} size={18} prefix={`${mode}-result`}/></span><span data-task-caption>{initial.caption}</span></div>
  </figcaption>
</figure>
