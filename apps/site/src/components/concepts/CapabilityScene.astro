---
import NetworkGraph from './NetworkGraph.astro';
import ConceptMark from './ConceptMark.astro';
import {supportedHarnesses,capabilityMarks} from '../../../../gui/dev/site/identity-marks';
import {workPhases,agentPhases,taskPackets,taskMarks} from './capability-data';
import {capabilityGeometry} from '../../scripts/capability-geometry';
import {taskState} from '../../scripts/task-state';
import '../../styles/capability-scene.css';
interface Props {mode:'work'|'agent'}
const {mode}=Astro.props,isAgent=mode==='agent';
const phases=isAgent?agentPhases:workPhases,initial=phases[phases.length-1];
const initialState=taskState(phases,phases.length-1,initial.duration);
const {nodes,userPath}=capabilityGeometry(false);
const marks=Object.fromEntries(supportedHarnesses.map(mark=>[mark.name,mark.svg]));
const glyph=(name:string)=>name==='agent'?marks.Codex:marks[name]??capabilityMarks[name];
const recipients=isAgent?['linux','mac','windows','phone','khor','you'] as const:['linux','mac','windows','phone'] as const;
const description=isAgent?'You stay outside KhorNet and give its boundary Khor Agent a vision-model training goal. Khor routes planning to the workstation agent, GPU training to the server terminal, evaluation and configuration revision to the laptop, and retraining to the server. A Web preview becomes available on Mobile. Khor collects the model and returns it with the preview to you for review.':'You plan a vision-model training job with the workstation agent and send it to the server terminal. You move to the laptop while GPU training continues, inspect validation results, revise the configuration and send it back for retraining. You then try the Web preview on Mobile; inference stays on Server.';
---
<figure class:list={['concept','concept-network','task-scene',`task-${mode}`]} data-concept={mode} data-task-stage="done" data-task-complete="true" data-task-ready="true" data-task-accepted="true" data-task-run="2" data-net-connection="p2p" style="--net-build:1">
  <p class="task-goal">Train a vision model</p>
  <NetworkGraph prefix={mode} infrastructure={false} externalUser={isAgent} title={isAgent?'Khor routes the training task and brings the result back to you':'Train, review and try a model across your devices'} {description}>
    <Fragment slot="clearances">
      <rect data-task-user-cut x={isAgent?nodes.you.x-36:nodes.phone.x-36} y={isAgent?nodes.you.y-16:nodes.phone.y+49} width="72" height="33" fill="black"/>
      <rect data-task-runtime-cut x={nodes.linux.x-70} y={nodes.linux.y+49} width="140" height="33" fill="black"/>
    </Fragment>
    <g slot="routes" class="task-operation" aria-hidden="true">
      {isAgent&&<path class="task-user-link" data-task-user-link d={userPath}/>}
      <path class="task-route" data-task-route d="M0 0"/>
      <g class="task-packet" data-task-packet opacity="0">
        <circle r="14"/>
        {taskPackets.map(name=><g data-task-payload={name}><svg x="-9" y="-9" width="18" height="18"><ConceptMark svg={glyph(name)} x={0} y={0} size={18} prefix={`${mode}-packet-${name}`}/></svg></g>)}
      </g>
    </g>
    <g slot="activity" class="task-activity">
      <g data-task-server transform={`translate(${nodes.linux.x} ${nodes.linux.y})`}>
        <g data-task-server-runtime>
          <circle class="task-progress-track" r="43"/>
          <circle class="task-progress" data-task-progress r="43" pathLength="1" transform="rotate(-90)"/>
          <text class="task-runtime-label" data-task-runtime x="0" y="72" text-anchor="middle">Ready</text>
        </g>
      </g>
      {isAgent&&<circle class="task-router-ring" data-task-router-ring cx={nodes.khor.x} cy={nodes.khor.y} r="27"/>}
      {isAgent?
        <g class="task-outsider" data-task-user transform={`translate(${nodes.you.x} ${nodes.you.y})`}><circle r="28"/><text x="0" y="6" text-anchor="middle">You</text></g>:
        <g class="task-user" data-task-user transform={`translate(${nodes.phone.x} ${nodes.phone.y+70})`}><circle cx="-22" cy="-5" r="3"/><text x="-12" y="0">You</text></g>
      }
      {recipients.map(device=><g data-task-receipt-at={device} transform={`translate(${nodes[device].x} ${nodes[device].y})`}>
        <g class="task-badge task-receipt" data-task-receipt={device} data-has-receipt={String(!!initialState.receipts[device])} transform={device==='phone'?'translate(28 -28)':device==='you'?'translate(23 23)':device==='khor'?'translate(-22 22)':'translate(28 28)'}>
          <circle r="15"/>
          {taskMarks.map(name=><g data-receipt-payload={name} data-visible={name===(device==='linux'?'check':initialState.receipts[device])?'true':'false'}><svg x="-10" y="-10" width="20" height="20"><ConceptMark svg={glyph(name)} x={0} y={0} size={20} prefix={`${mode}-${device}-received-${name}`}/></svg></g>)}
        </g>
      </g>)}
    </g>
  </NetworkGraph>
  <figcaption class="task-caption">
    <div><span class="task-caption-check" aria-hidden="true"><ConceptMark svg={glyph('check')} x={0} y={0} size={18} prefix={`${mode}-result`}/></span><span data-task-caption>{initial.caption}</span></div>
  </figcaption>
</figure>
