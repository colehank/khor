---
import ConceptMark from './ConceptMark.astro';
import {supportedDevices} from '../../../../gui/dev/site/identity-marks';
const marks=Object.fromEntries(supportedDevices.map(mark=>[mark.name,mark.svg]));
---
<figure class="concept concept-peer" data-concept="peer" data-resource="file" aria-label="Files and web apps stay on your Mac and connect to your phone through Khor">
  <div class="concept-stage peer-stage">
    <div class="network-place place-desk"><span>At your desk</span></div>
    <div class="network-place place-away"><span>With you</span></div>
    <svg class="diagram-routes" viewBox="0 0 600 400" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path class="context-route" d="M132 144 Q132 240 240 272"/>
      <path class="context-route" d="M240 272 Q365 192 492 256"/>
      <path class="resource-route file-route" d="M132 144 C208 -4 425 2 492 256"/>
      <path class="resource-route web-route" d="M132 144 C210 369 425 385 492 256"/>
      <path class="travel-route file-route" pathLength="1" d="M132 144 C208 -4 425 2 492 256"/>
      <path class="travel-route web-route" pathLength="1" d="M132 144 C210 369 425 385 492 256"/>
    </svg>
    <div class="diagram-node peer-mac">
      <span class="node-disc"><ConceptMark svg={marks.macOS} x={0} y={0} size={24} prefix="peer-mac"/></span>
      <span class="node-name">MacBook Pro</span><span class="node-detail">Your files &amp; web apps</span>
    </div>
    <div class="diagram-node peer-linux">
      <span class="node-disc"><ConceptMark svg={marks.Linux} x={0} y={0} size={24} prefix="peer-linux"/></span>
      <span class="node-name">build-01</span><span class="node-detail">Linux</span>
    </div>
    <div class="diagram-node peer-phone">
      <span class="node-disc"><ConceptMark svg={marks.iOS} x={0} y={0} size={24} prefix="peer-phone"/></span>
      <span class="node-name">iPhone</span><span class="node-detail">In your hand</span>
    </div>
    <span class="route-label resource-label file-label"><code>src/export.ts</code></span>
    <span class="route-label resource-label web-label"><code>localhost:5173</code></span>
  </div>
  <figcaption class="concept-footer">
    <div><strong data-peer-title>A file on your Mac</strong><span>Example connection</span></div>
    <div class="concept-options" role="group" aria-label="Choose a resource to connect">
      <button type="button" data-resource-choice="file" aria-pressed="true">Files</button>
      <button type="button" data-resource-choice="web" aria-pressed="false">Web apps</button>
    </div>
  </figcaption>
</figure>
