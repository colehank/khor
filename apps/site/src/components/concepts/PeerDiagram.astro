---
import ConceptMark from './ConceptMark.astro';
import {supportedDevices} from '../../../../gui/dev/site/identity-marks';
const marks=Object.fromEntries(supportedDevices.map(mark=>[mark.name,mark.svg]));
---
<figure class="concept concept-peer" data-concept="peer" data-resource="file" aria-label="Open a file or web app on MacBook Pro from iPhone">
  <div class="peer-endpoints">
    <div class="device-identity">
      <span class="device-mark"><ConceptMark svg={marks.macOS} x={0} y={0} size={32} prefix="peer-mac"/></span>
      <div><strong>MacBook Pro</strong><span>At your desk</span></div>
    </div>
    <div class="peer-connection" aria-hidden="true"><span></span><span></span></div>
    <div class="device-identity peer-destination">
      <span class="device-mark"><ConceptMark svg={marks.iOS} x={0} y={0} size={32} prefix="peer-phone"/></span>
      <div><strong>iPhone</strong><span>With you</span></div>
    </div>
  </div>
  <div class="resource-surface paper-surface">
    <div data-resource-panel="file">
      <div class="resource-location"><span>README.md</span><span>atlas-web</span></div>
      <div class="resource-content document-content">
        <h3>Atlas Web</h3>
        <p>Order exports, with the right dates</p>
        <div class="document-section">
          <h4>Local dates, kept intact</h4>
          <p>CSV exports use the order’s local date, including orders placed around midnight</p>
        </div>
        <div class="document-code"><span>Order, Date, Total</span><code>A1048, 2026-03-01, 129.00</code></div>
      </div>
    </div>
    <div data-resource-panel="web" hidden>
      <div class="resource-location"><span>localhost:5173</span><span>atlas-web</span></div>
      <div class="resource-content web-content">
        <h3>Atlas Web</h3>
        <p>Your orders, ready to export</p>
        <table class="orders-example">
          <caption class="sr-only">Example orders from the web app on MacBook Pro</caption>
          <thead><tr><th>Order</th><th>Local date</th><th>Total</th></tr></thead>
          <tbody><tr><td>A1048</td><td>Mar 1, 2026</td><td>$129.00</td></tr><tr><td>A1047</td><td>Feb 28, 2026</td><td>$84.00</td></tr></tbody>
        </table>
        <div class="web-export"><span>CSV export</span><span>Local dates preserved</span></div>
      </div>
    </div>
  </div>
  <figcaption class="concept-caption peer-caption">
    <div><span class="caption-primary">On your Mac, open on your phone</span><span class="example-label">Example connection</span></div>
    <div class="concept-controls">
      <div class="concept-options" role="group" aria-label="Choose a resource to connect">
        <button type="button" data-resource-choice="file" aria-pressed="true">Files</button>
        <button type="button" data-resource-choice="web" aria-pressed="false">Web apps</button>
      </div>
      <button class="concept-motion" type="button" data-motion-toggle="connection" aria-label="Pause connection animation">Pause</button>
    </div>
  </figcaption>
</figure>
