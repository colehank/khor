---
import ConceptMark from './ConceptMark.astro';
import {supportedDevices,supportedHarnesses} from '../../../../gui/dev/site/identity-marks';
import {networkGeometry,networkNodeRadius} from '../../scripts/network-geometry';
import '../../styles/network-scene.css';
const marks=Object.fromEntries([...supportedDevices,...supportedHarnesses].map(mark=>[mark.name,mark.svg]));
const initial=networkGeometry(false,0);
const devices=[{id:'linux',name:'Linux'},{id:'mac',name:'macOS'},{id:'windows',name:'Windows'},{id:'phone',name:'iOS'}] as const;
const areaNames={a:'Wi-Fi A',b:'Wi-Fi B',cellular:'Cellular'};
---
<figure class="concept concept-network" data-concept="network" data-route="direct" data-location="a" data-net-phase="local" aria-label="Connection example: an iPhone moves between two Wi-Fi networks and cellular, using a relay while a direct path is established">
  <svg class="network-scene" data-net-scene viewBox={initial.box} role="img" aria-labelledby="network-scene-title network-scene-desc">
    <title id="network-scene-title">Your devices, across networks</title>
    <desc id="network-scene-desc">Each enclosed group is a network. Linux and macOS share Wi-Fi A. Windows is on Wi-Fi B. The iOS node moves between these groups and cellular. The Khor node relays traffic while a direct connection is attempted.</desc>
    <g class="net-regions">
      {Object.entries(initial.areas).map(([id,area])=>(
        <g data-net-area={id} style={`opacity:${area.opacity}`} aria-hidden={area.opacity===0?'true':'false'}>
          <path d={area.d}/>
          <text text-anchor="middle" x={area.label.x} y={area.label.y}>{areaNames[id as keyof typeof areaNames]}</text>
        </g>
      ))}
    </g>
    <g class="net-routes" fill="none" aria-hidden="true">
      <path class="net-relay-line" data-net-wire="relay-in" d={initial.routes['relay-in']}/>
      <path class="net-relay-line" data-net-wire="relay-out" d={initial.routes['relay-out']}/>
      <path class="net-direct-line" data-net-wire="direct" d={initial.routes.direct}/>
      <path class="net-packet net-relay-packet" data-net-copy="relay-in" pathLength="1"/>
      <path class="net-packet net-relay-packet" data-net-copy="relay-out" pathLength="1"/>
      <path class="net-packet net-direct-packet" data-net-copy="direct" pathLength="1"/>
    </g>
    {devices.map(({id,name})=>(
      <g class="net-device" data-net-device={id} transform={`translate(${initial.nodes[id].x} ${initial.nodes[id].y})`}>
        <title>{name}</title>
        <circle class="net-device-body" r={networkNodeRadius}/>
        <svg x="-18" y="-18" width="36" height="36"><ConceptMark svg={marks[name]} x={0} y={0} size={36} prefix={`roam-${id}`}/></svg>
      </g>
    ))}
    <g class="net-relay" data-net-device="relay" transform={`translate(${initial.nodes.relay.x} ${initial.nodes.relay.y})`}>
      <title>Khor relay</title>
      <circle class="net-relay-body" r="25"/>
      <svg x="-17" y="-17" width="34" height="34"><ConceptMark svg={marks.Khor} x={0} y={0} size={34} prefix="roam-relay"/></svg>
    </g>
  </svg>
  <figcaption class="net-caption">
    <div class="net-explanation"><strong data-net-status>Same network, direct connection</strong><span data-net-detail>iPhone reaches macOS over Wi-Fi A</span></div>
    <div class="net-controls">
      <div class="net-locations" role="group" aria-label="iPhone network">
        <button type="button" data-net-location="a" aria-pressed="true">Wi-Fi A</button>
        <button type="button" data-net-location="cellular" aria-pressed="false">Cellular</button>
        <button type="button" data-net-location="b" aria-pressed="false">Wi-Fi B</button>
      </div>
      <button class="concept-motion" type="button" data-motion-toggle="network" aria-label="Pause network animation">Pause</button>
    </div>
  </figcaption>
</figure>
