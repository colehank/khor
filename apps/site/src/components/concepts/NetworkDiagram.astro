---
import ConceptMark from './ConceptMark.astro';
import {supportedDevices,supportedHarnesses,networkTypeMarks} from '../../../../gui/dev/site/identity-marks';
import {networkGeometry,networkNodeRadius} from '../../scripts/network-geometry';
import '../../styles/network-scene.css';
const marks=Object.fromEntries([...supportedDevices,...supportedHarnesses].map(mark=>[mark.name,mark.svg]));
const initial=networkGeometry(false,1);
const devices=[{id:'mac',name:'macOS'},{id:'linux',name:'Linux'},{id:'windows',name:'Windows'},{id:'phone',name:'iOS'}] as const;
const areaNames={a:'NetA · Local network',b:'NetB · Wi-Fi',c:'NetC · Cellular'};
const areaLabels={a:'LAN',b:'Wi-Fi',c:'Cellular'};
const labelWidths={a:50,b:65,c:90};
---
<figure class="concept concept-network" data-concept="network" data-net-phase="connected" data-location="b" data-net-travel="false" data-net-connection="p2p" style="--net-build:1" aria-label="Khor connects every device across changing networks">
  <svg class="network-scene" data-net-scene viewBox={initial.box} role="img" aria-labelledby="network-scene-title network-scene-desc">
    <title id="network-scene-title">Your devices, your net</title>
    <desc id="network-scene-desc">LAN contains macOS and Linux. Wi-Fi contains the same Linux device and Windows. iOS starts on Wi-Fi, moves to cellular and returns to Wi-Fi. KhorNet forms once around all four devices and stays connected as iOS moves. Icons and names sit on network boundaries. During the illustrated handoff, relaying carries traffic while hole punching attempts a direct connection.</desc>
    <defs>
      {Object.entries(initial.areas).map(([id,area])=>(
        <path id={`network-label-${id}`} data-net-label-path={id} d={area.labelPath}/>
      ))}
      <path id="network-label-khor" data-net-label-path="khor" d={initial.khorNet.labelPath}/>
      <path id="network-label-khor-subtitle" data-net-label-path="khor-subtitle" d={initial.khorNet.subtitlePath}/>
      <mask id="network-edge-clearance" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="690" style="mask-type:luminance">
        <rect width="1000" height="690" fill="white"/>
        {Object.entries(initial.areas).map(([id,area])=>(
          <g data-net-gap-group={id} style={`opacity:${area.opacity}`}>
            <circle data-net-gap-icon={id} cx={area.mark.x} cy={area.mark.y} r="23" fill="black"/>
            <path data-net-gap={id} d={area.labelPath} fill="none" stroke="black" stroke-width="30" stroke-dasharray={`0 16 ${labelWidths[id as keyof typeof labelWidths]} 10000`}/>
          </g>
        ))}
        <g class="net-khor-gap">
          <circle data-net-gap-icon="khor" cx={initial.khorNet.mark.x} cy={initial.khorNet.mark.y} r="25" fill="black"/>
          <path data-net-gap="khor" d={initial.khorNet.labelPath} fill="none" stroke="black" stroke-width="30" stroke-dasharray="0 18 135 10000"/>
          <path class="net-hole-clearance" data-net-gap="khor-subtitle" d={initial.khorNet.subtitlePath} fill="none" stroke="black" stroke-width="30" stroke-dasharray="0 18 125 10000"/>
        </g>
      </mask>
    </defs>
    <g class="net-surfaces">
      <path class="net-khor-surface" data-net-global-fill d={initial.khorNet.d}/>
      {Object.entries(initial.areas).map(([id,area])=>(
        <path class="net-native-surface" data-net-area-fill={id} d={area.d} style={`opacity:${area.opacity}`}/>
      ))}
    </g>
    <g mask="url(#network-edge-clearance)">
      <path class="net-khor-shape" data-net-global d={initial.khorNet.d} pathLength="1"/>
      <g class="net-native">
        {Object.entries(initial.areas).map(([id,area])=>(
          <g data-net-area={id} style={`opacity:${area.opacity}`} aria-hidden={area.opacity===0?'true':'false'}>
            <path d={area.d}/>
          </g>
        ))}
      </g>
    </g>
    {devices.map(({id,name})=>(
      <g class="net-device" data-net-device={id} transform={`translate(${initial.nodes[id].x} ${initial.nodes[id].y})`}>
        <title>{name}</title>
        <circle class="net-device-body" r={networkNodeRadius}/>
        <svg x="-18" y="-18" width="36" height="36"><ConceptMark svg={marks[name]} x={0} y={0} size={36} prefix={`roam-${id}`}/></svg>
      </g>
    ))}
    <g class="net-boundary-marks">
      {Object.entries(initial.areas).map(([id,area])=>(
        <g data-net-mark={id} style={`opacity:${area.opacity}`}>
          <title>{areaNames[id as keyof typeof areaNames]}</title>
          <g data-net-icon transform={`translate(${area.mark.x} ${area.mark.y})`}>
            <circle class="net-mark-ground" r="19"/>
            <svg x="-14" y="-14" width="28" height="28"><ConceptMark svg={networkTypeMarks[id]} x={0} y={0} size={28} prefix={`network-type-${id}`}/></svg>
          </g>
          <text class="net-boundary-name"><textPath href={`#network-label-${id}`} startOffset="24">{areaLabels[id as keyof typeof areaLabels]}</textPath></text>
        </g>
      ))}
    </g>
    <g class="net-khor-mark">
      <title>KhorNet · All your devices</title>
      <g data-net-brand transform={`translate(${initial.khorNet.mark.x} ${initial.khorNet.mark.y})`}>
        <circle class="net-mark-ground" r="21"/>
        <svg x="-16" y="-16" width="32" height="32"><ConceptMark svg={marks.Khor} x={0} y={0} size={32} prefix="network-khor"/></svg>
      </g>
      <text class="net-boundary-name"><textPath href="#network-label-khor" startOffset="26">KhorNet <tspan data-net-connection-label>P2P</tspan></textPath></text>
      <text class="net-handoff-status" aria-hidden="true"><textPath class="net-status-pulse" href="#network-label-khor-subtitle" startOffset="26">hole punching</textPath></text>
    </g>
  </svg>
</figure>
