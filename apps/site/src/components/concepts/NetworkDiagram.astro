---
import ConceptMark from './ConceptMark.astro';
import {supportedDevices,supportedHarnesses} from '../../../../gui/dev/site/identity-marks';
import '../../styles/network-scene.css';
const marks=Object.fromEntries([...supportedDevices,...supportedHarnesses].map(mark=>[mark.name,mark.svg]));
const nodeRadius=40;
---
<figure class="concept concept-network" data-concept="network" data-route="direct" data-location="a" data-net-phase="local" aria-label="Connection example: an iPhone moves between two Wi-Fi networks and cellular, using a relay while a direct path is established">
  <svg class="network-scene" data-net-scene viewBox="0 0 1000 500" role="img" aria-labelledby="network-scene-title network-scene-desc">
    <title id="network-scene-title">Your devices, across networks</title>
    <desc id="network-scene-desc">Linux and macOS share Wi-Fi A. Windows is on Wi-Fi B. The iPhone moves between them and cellular. Relay traffic and direct connection attempts happen together.</desc>
    <g class="net-regions">
      <rect data-net-area="a" x="20" y="140" width="400" height="330" rx="24"/>
      <rect data-net-area="b" x="650" y="140" width="330" height="330" rx="24"/>
      <text data-net-area-label="a" x="48" y="177">Wi-Fi A</text>
      <text data-net-area-label="b" x="678" y="177">Wi-Fi B</text>
    </g>
    <g class="net-routes" fill="none" aria-hidden="true">
      <path class="net-local-wire" data-net-wire="lan" d="M160 240 H270"/>
      <path class="net-backbone" data-net-wire="backbone" d="M350 240 H780"/>
      <path class="net-nearby-wire" data-net-wire="nearby" d="M860 240 C932 240 932 380 350 380"/>
      <path class="net-relay-line" data-net-wire="relay-in" d="M350 240 C414 240 434 55 505 55"/>
      <path class="net-relay-line" data-net-wire="relay-out" d="M530 80 C530 185 310 294 310 340"/>
      <path class="net-direct-line" data-net-wire="direct" d="M350 240 C380 240 350 380 350 380"/>
      <path class="net-packet net-relay-packet" data-net-copy="relay-in" pathLength="1"/>
      <path class="net-packet net-relay-packet" data-net-copy="relay-out" pathLength="1"/>
      <path class="net-packet net-direct-packet" data-net-copy="direct" pathLength="1"/>
    </g>
    <g class="net-device" data-net-device="linux" transform="translate(120 240)">
      <circle class="net-device-body" r={nodeRadius}/>
      <svg x="-18" y="-18" width="36" height="36"><ConceptMark svg={marks.Linux} x={0} y={0} size={36} prefix="roam-linux"/></svg>
      <text class="net-device-name" text-anchor="middle" y="68">Linux</text>
    </g>
    <g class="net-device" data-net-device="mac" transform="translate(310 240)">
      <circle class="net-device-body" r={nodeRadius}/>
      <svg x="-18" y="-18" width="36" height="36"><ConceptMark svg={marks.macOS} x={0} y={0} size={36} prefix="roam-mac"/></svg>
      <text class="net-device-name" text-anchor="middle" y="68">macOS</text>
    </g>
    <g class="net-device" data-net-device="windows" transform="translate(820 240)">
      <circle class="net-device-body" r={nodeRadius}/>
      <svg x="-18" y="-18" width="36" height="36"><ConceptMark svg={marks.Windows} x={0} y={0} size={36} prefix="roam-windows"/></svg>
      <text class="net-device-name" text-anchor="middle" y="68">Windows</text>
    </g>
    <g class="net-relay" data-net-device="relay" transform="translate(530 55)">
      <circle class="net-relay-body" r="25"/>
      <svg x="-17" y="-17" width="34" height="34"><ConceptMark svg={marks.Khor} x={0} y={0} size={34} prefix="roam-relay"/></svg>
      <text text-anchor="start" x="40" y="7">Khor relay</text>
    </g>
    <g class="net-device" data-net-device="phone" transform="translate(310 380)">
      <circle class="net-device-body" r={nodeRadius}/>
      <svg x="-18" y="-18" width="36" height="36"><ConceptMark svg={marks.iOS} x={0} y={0} size={36} prefix="roam-ios"/></svg>
      <text class="net-device-name" text-anchor="middle" y="68">iOS</text>
    </g>
  </svg>
  <figcaption class="net-caption">
    <div class="net-explanation"><strong data-net-status>Same network, direct connection</strong><span data-net-detail>iPhone reaches macOS over Wi-Fi A</span></div>
    <div class="net-controls">
      <div class="net-locations" role="group" aria-label="iPhone network">
        <button type="button" data-net-location="a" aria-pressed="true">Wi-Fi A</button>
        <button type="button" data-net-location="cellular" aria-pressed="false">Cellular</button>
        <button type="button" data-net-location="b" aria-pressed="false">Wi-Fi B</button>
      </div>
      <button class="concept-motion" type="button" data-motion-toggle="network" aria-label="Pause network animation">Pause</button>
    </div>
  </figcaption>
</figure>
