---
import ConceptMark from './ConceptMark.astro';
import {supportedDevices} from '../../../../gui/dev/site/identity-marks';
const marks=Object.fromEntries(supportedDevices.map(mark=>[mark.name,mark.svg]));
---
<figure class="concept concept-terminal" data-concept="terminal" data-view="desktop" aria-label="The same terminal keeps running on MacBook Pro while you switch the viewing device">
  <div class="concept-stage terminal-stage">
    <svg class="diagram-routes" viewBox="0 0 600 400" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path class="viewer-route desktop-route" d="M300 140 C300 228 114 214 114 312"/>
      <path class="viewer-route phone-route" d="M300 140 C300 228 486 214 486 312"/>
      <path class="travel-route desktop-route" pathLength="1" d="M300 140 C300 228 114 214 114 312"/>
      <path class="travel-route phone-route" pathLength="1" d="M300 140 C300 228 486 214 486 312"/>
    </svg>
    <div class="process-note">
      <div class="process-owner"><span class="process-dot"></span><span>MacBook Pro</span><span class="process-state">Running</span></div>
      <strong>atlas-web</strong>
      <code><span>$</span> npm run dev</code>
    </div>
    <span class="route-label process-anchor">Keeps running here</span>
    <button class="diagram-node terminal-desktop" type="button" data-view-choice="desktop" aria-pressed="true" aria-label="View the same terminal from Desktop">
      <span class="node-disc"><ConceptMark svg={marks.macOS} x={0} y={0} size={24} prefix="terminal-mac"/></span>
      <span class="node-name">Desktop</span><span class="node-detail">Your view</span>
    </button>
    <button class="diagram-node terminal-phone" type="button" data-view-choice="phone" aria-pressed="false" aria-label="View the same terminal from Phone">
      <span class="node-disc"><ConceptMark svg={marks.iOS} x={0} y={0} size={24} prefix="terminal-phone"/></span>
      <span class="node-name">Phone</span><span class="node-detail">Your view</span>
    </button>
  </div>
  <figcaption class="concept-footer">
    <div><strong data-view-status>Viewing from Desktop</strong><span>Example session</span></div>
    <span class="session-label">Same session</span>
  </figcaption>
</figure>
