---
import ConceptMark from './ConceptMark.astro';
import {supportedHarnesses,copyControlMarks} from '../../../../gui/dev/site/identity-marks';
const marks=Object.fromEntries(supportedHarnesses.map(mark=>[mark.name,mark.svg]));
const {check}=copyControlMarks('agent-result');
---
<figure class="concept concept-agent" data-concept="agent" data-phase="ready" aria-label="Khor delegates one request to Codex and Claude on different devices and gathers their results">
  <div class="concept-stage agent-stage">
    <svg class="diagram-routes" viewBox="0 0 600 400" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path class="dispatch-route" d="M120 200 C210 200 210 96 300 96"/>
      <path class="dispatch-route" d="M120 200 C210 200 210 304 300 304"/>
      <path class="return-route" d="M300 96 C390 96 390 200 480 200"/>
      <path class="return-route" d="M300 304 C390 304 390 200 480 200"/>
      <path class="travel-route dispatch-travel" pathLength="1" d="M120 200 C210 200 210 96 300 96"/>
      <path class="travel-route dispatch-travel" pathLength="1" d="M120 200 C210 200 210 304 300 304"/>
      <path class="travel-route return-travel" pathLength="1" d="M300 96 C390 96 390 200 480 200"/>
      <path class="travel-route return-travel" pathLength="1" d="M300 304 C390 304 390 200 480 200"/>
    </svg>
    <div class="diagram-node agent-khor">
      <span class="node-disc mind-disc"><ConceptMark svg={marks.Khor} x={0} y={0} size={44} prefix="agent-khor"/></span>
      <span class="node-name">Khor</span><span class="node-detail">Your task</span>
    </div>
    <div class="diagram-node agent-codex">
      <span class="node-disc"><ConceptMark svg={marks.Codex} x={0} y={0} size={24} prefix="agent-codex"/></span>
      <span class="node-name">Codex</span><span class="node-detail"><span class="worker-task">Code review · </span>build-01</span>
    </div>
    <div class="diagram-node agent-claude">
      <span class="node-disc"><ConceptMark svg={marks.Claude} x={0} y={0} size={24} prefix="agent-claude"/></span>
      <span class="node-name">Claude</span><span class="node-detail"><span class="worker-task">Project notes · </span>Mac mini</span>
    </div>
    <div class="diagram-node agent-collected">
      <span class="node-disc result-disc"><span class="result-check"><ConceptMark svg={check} x={0} y={0} size={24} prefix="agent-result"/></span></span>
      <span class="node-name" data-agent-result>Ready</span><span class="node-detail">Back to you</span>
    </div>
  </div>
  <figcaption class="concept-footer">
    <div><strong data-agent-status>Two results, together</strong><span>Example task</span></div>
    <button class="concept-replay" type="button" data-replay-agent>Replay</button>
  </figcaption>
</figure>
