---
import type {ImageMetadata} from 'astro';
interface Props {
  image:{light:ImageMetadata;dark:ImageMetadata;mobileLight:ImageMetadata;mobileDark:ImageMetadata};
  alt:string;
  mode?:'responsive'|'desktop'|'phone';
}
const {image,alt,mode='responsive'}=Astro.props;
const sources=mode==='desktop'?{light:image.light,dark:image.dark,mobileLight:image.light,mobileDark:image.dark}:mode==='phone'?{light:image.mobileLight,dark:image.mobileDark,mobileLight:image.mobileLight,mobileDark:image.mobileDark}:image;
---
<picture>
  <source media="(max-width:760px) and (prefers-color-scheme:dark)" srcset={sources.mobileDark.src} width={sources.mobileDark.width} height={sources.mobileDark.height} />
  <source media="(max-width:760px)" srcset={sources.mobileLight.src} width={sources.mobileLight.width} height={sources.mobileLight.height} />
  <source media="(prefers-color-scheme:dark)" srcset={sources.dark.src} width={sources.dark.width} height={sources.dark.height} />
  <img src={sources.light.src} width={sources.light.width} height={sources.light.height} alt={alt} loading="lazy" decoding="async" />
</picture>
