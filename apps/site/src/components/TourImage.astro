---
import type {ImageMetadata} from 'astro';
interface Props {
  image:{light:ImageMetadata;dark:ImageMetadata;mobileLight:ImageMetadata;mobileDark:ImageMetadata};
  alt:string;
}
const {image,alt}=Astro.props;
---
<picture>
  <source media="(max-width:760px) and (prefers-color-scheme:dark)" srcset={image.mobileDark.src} width={image.mobileDark.width} height={image.mobileDark.height} />
  <source media="(max-width:760px)" srcset={image.mobileLight.src} width={image.mobileLight.width} height={image.mobileLight.height} />
  <source media="(prefers-color-scheme:dark)" srcset={image.dark.src} width={image.dark.width} height={image.dark.height} />
  <img src={image.light.src} width={image.light.width} height={image.light.height} alt={alt} loading="lazy" decoding="async" />
</picture>
