---
import artwork from "../../../gui/src-tauri/icons/src/mandala-glass.svg?raw";
import brands from "../../../gui/src/components/BrandIcons.tsx?raw";
const faces = ["Claude", "Codex", "Cursor", "Agent"].map(name => {
  const match = new RegExp(`export const Icon${name} = brand\\(\\s*\x60([\\s\\S]*?)\x60,\\s*"([^"]+)"`).exec(brands);
  if (!match) throw new Error(`Missing app session mark: ${name}`);
  return {body:match[1],box:match[2]};
});
---
<div class="canonical-icon" set:html={artwork} aria-hidden="true"></div>
<div data-session-marks hidden>{faces.map(face => <svg viewBox={face.box} fill="currentColor" set:html={face.body}/>)}</div>
