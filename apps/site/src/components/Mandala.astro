---
import {brandArtwork as artwork} from '../brand-artwork';
import {deviceMarks,harnessMarks} from "../../../gui/dev/site/identity-marks";
---
<div class="canonical-icon" set:html={artwork} aria-hidden="true"></div>
<div data-device-marks hidden>{deviceMarks.map(mark => <span data-mark={mark.name} set:html={mark.svg}/>)}</div>
<div data-harness-marks hidden>{harnessMarks.map(mark => <span data-mark={mark.name} set:html={mark.svg}/>)}</div>
