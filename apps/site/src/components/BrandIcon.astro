---
import artwork from '../../../gui/src-tauri/icons/src/mandala-glass.svg?raw';
import ConceptMark from './concepts/ConceptMark.astro';
interface Props {prefix:string;size?:number;}
const {prefix,size=22}=Astro.props;
// The same physical artwork layer used by the icon story. Keep its glass,
// light, pearls and optical transform; omit the app tile and ambient ground.
const definitions=artwork.match(/<defs>[\s\S]*?<\/defs>/)?.[0];
const material=artwork.match(/<g transform="translate\(2\.6 \.88\) scale\(\.9922\)">[\s\S]*<\/g>(?=<\/svg>\s*$)/)?.[0];
if(!definitions||!material)throw new Error('The canonical Khor icon layer contract has changed');
const transparent=`<svg viewBox="64 64 896 896" xmlns="http://www.w3.org/2000/svg">${definitions}${material}</svg>`;
---
<span class="brand-icon" aria-hidden="true"><ConceptMark svg={transparent} x={0} y={0} {size} {prefix}/></span>
<style>
  .brand-icon { display:inline-flex; flex:none; vertical-align:middle; }
  .brand-icon :global(svg) { display:block; }
</style>
