---
import type {ImageMetadata} from 'astro';
interface Props {title:string;description:string;href:string;link:string;image:ImageMetadata;darkImage:ImageMetadata;alt:string;reverse?:boolean;}
const {title,description,href,link,image,darkImage,alt,reverse=false}=Astro.props;
---
<article class:list={['feature-story',{'is-reversed':reverse}]}>
  <div class="feature-copy"><h3>{title}</h3><p>{description}</p><a href={href}>{link} <span aria-hidden="true">↗</span></a></div>
  <picture class="feature-media"><source media="(prefers-color-scheme: dark)" srcset={darkImage.src} /><img src={image.src} width={image.width} height={image.height} alt={alt} loading="lazy" decoding="async" /></picture>
</article>
