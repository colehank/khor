---
import {copyControlMarks} from '../../../gui/dev/site/identity-marks';
import {localizedAttrs} from '../i18n';
interface Props { target:string; label?:string; labelZh?:string; class?:string; }
const {target,label='Copy the install command',labelZh='复制安装命令',class:className}=Astro.props;
const marks=copyControlMarks(target);
---
<button type="button" class:list={['copy-button',className]} data-copy={target} {...localizedAttrs({'aria-label':[label,labelZh],title:[label,labelZh]})}>
  <slot />
  <span class="copy-symbol" aria-hidden="true"><span data-copy-idle set:html={marks.copy}/><span data-copy-done set:html={marks.check}/></span>
  <span class="sr-only" data-copy-label role="status" aria-live="polite"></span>
</button>
