---
import {sitePath} from "../../paths";
import { render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { docs } from "../../site";

export async function getStaticPaths() {
  const pages = await docs();
  return pages.map((page, i) => ({
    params: { id: page.id },
    props: { page, prev: pages[i - 1], next: pages[i + 1] },
  }));
}
const { page, prev, next } = Astro.props;
const { Content } = await render(page);
---

<Docs title={page.data.title} description={page.data.summary} current={page.id}>
  <article class="prose">
    <Content />
  </article>
  <nav class="turn" aria-label="Previous and next pages">
    {prev ? <a href={sitePath(`/docs/${prev.id}/`)}><span>Previous</span>{prev.data.title}</a> : <span />}
    {next && <a class="turn-next" href={sitePath(`/docs/${next.id}/`)}><span>Next</span>{next.data.title}</a>}
  </nav>
</Docs>
