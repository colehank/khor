---
import {sitePath} from "../../paths";
import Docs from "../../layouts/Docs.astro";
import { docs } from "../../site";

const pages = await docs();
---

<Docs title="Docs" description="Install Khor, connect your devices, start sessions, and run your own relay">
  <div class="overview">
    {
      pages.map((p) => (
        <a class="overview-row" href={sitePath(`/docs/${p.id}/`)}>
          <strong>{p.data.title}</strong>
          <span>{p.data.summary}</span>
        </a>
      ))
    }
  </div>
</Docs>
