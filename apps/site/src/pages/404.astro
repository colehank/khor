---
import {sitePath} from "../paths";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
---

<Base title="没有这一页">
  <header class="bar"><Mark /></header>
  <main class="empty">
    <h1>没有这一页</h1>
    <p><a href={sitePath("/")}>回首页</a>，或者去<a href={sitePath("/docs/")}>文档</a>找</p>
  </main>
</Base>
