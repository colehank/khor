---
import '../../styles/site.css';
const orders=[['A1048','林晨','2026-03-01','129.00'],['A1049','陈蕾','2026-03-01','268.00'],['A1050','赵明','2026-03-02','96.00']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Atlas Web · 订单</title></head>
<body class="atlas-resource">
  <header><strong>Atlas Web</strong><span>订单与客户管理</span></header>
  <main><div class="atlas-heading"><h1>订单</h1><span>北京时间 · Asia/Shanghai</span></div>
    <p>最近的订单与导出记录。</p>
    <div class="atlas-table"><table><thead><tr><th>订单号</th><th>客户</th><th>下单日期</th><th>金额</th></tr></thead><tbody>{orders.map(order=><tr>{order.map(value=><td>{value}</td>)}</tr>)}</tbody></table></div>
    <section><h2>导出已就绪</h2><p>日期与订单列表保持一致，CSV 包含订单号、下单日期和金额。</p><pre><code>订单号,下单日期,金额<br/>A1048,2026-03-01,129.00</code></pre><span class="atlas-result">8 项导出测试通过</span></section>
  </main>
</body></html>
<style>
  .atlas-resource { min-height:100svh; padding:var(--gap-pane); background:var(--canvas); }
  header { display:flex; align-items:center; flex-wrap:wrap; gap:var(--gap-row); padding-bottom:var(--gap-group); border-bottom:var(--hair) solid var(--hairline); }
  header strong { font-size:var(--text-title-md); }
  header span,.atlas-heading span { color:var(--secondary); font-size:var(--text-caption); }
  main { padding-top:calc(var(--gap-pane)*2); }
  .atlas-heading { display:flex; align-items:baseline; flex-wrap:wrap; gap:var(--gap-row); }
  h1 { font-size:calc(var(--text-title-lg)*1.5); font-weight:600; }
  main > p { margin-top:var(--gap-in); color:var(--secondary); }
  .atlas-table { margin-top:var(--gap-group); overflow:auto; }
  table { border-collapse:collapse; width:100%; font-size:var(--text-callout); white-space:nowrap; }
  th,td { border-bottom:var(--hair) solid var(--hairline); padding:var(--gap-base) var(--gap-in); text-align:left; }
  th { font-weight:500; color:var(--secondary); }
  th:last-child,td:last-child { text-align:right; }
  section { margin-top:calc(var(--gap-pane)*2); }
  h2 { font-size:var(--text-title-md); font-weight:600; }
  section p { margin-top:var(--gap-row); color:var(--secondary); font-size:var(--text-callout); line-height:1.65; }
  pre { padding:var(--gap-base); margin-top:var(--gap-base); overflow:auto; border-radius:var(--radius-md); background:var(--fill); font-size:var(--text-mono); line-height:1.8; }
  .atlas-result { display:block; margin-top:var(--gap-base); font-size:var(--text-caption); color:var(--secondary); }
  @media (max-width:450px) { .atlas-resource { padding:var(--gap-base); } main { padding-top:var(--gap-pane); } th,td { padding:var(--gap-row) var(--gap-xxs); } }
</style>
