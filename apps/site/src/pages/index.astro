---
import {sitePath} from "../paths";
import Base from "../layouts/Base.astro";
import Mandala from "../components/Mandala.astro";
import ProductHero from "../components/ProductHero.astro";
import ProductTour from "../components/ProductTour.astro";
import SiteNav from "../components/SiteNav.astro";
import ProductActions from '../components/ProductActions.astro';
import ProductInstallations from '../components/ProductInstallations.astro';
import icon from "../../../gui/src-tauri/icons/src/mandala-glass.svg";
import { REPO } from "../site";
import "../styles/story.css";
const lines = [["You have", "many devices"], ["With", "many harnesses"], ["But", "one mind"], ["How about", "letting them\nwork together?"], ["Meet", "Khor"]];
---
<Base title="Work across your devices and agents" description="Your agents, files, and web apps. Connected peer to peer. Khor by kapestack." productWorld>
  <a class="skip-story" href="#product">Skip to the product preview</a>
  <SiteNav home />
  <main class="story-home">
    <ProductHero />
    <section class="opening" id="story" aria-label="Meet Khor" data-opening>
      <div class="opening-sticky">
        <div class="meet-environment" data-meet-environment aria-hidden="true"></div>
        <div class="opening-copy" aria-hidden="true" lang="en">{lines.map(([lead, phrase], index) => <div class:list={["opening-line", {"is-current": index === 0}]} data-line={index}><p class="opening-line-content"><span class="line-lead">{lead}</span>{phrase.split("\n").map(text => <span class="line-phrase">{text}</span>)}</p></div>)}</div>
        <h2 class="sr-only" lang="en">You have many devices With many harnesses But one mind How about letting them work together? Meet Khor</h2>
        <div class="assembly" data-assembly><Mandala /></div>
        <div class="scroll-cue" aria-hidden="true"><span>Scroll to connect</span><span class="scroll-stem"><span class="scroll-stem-progress"></span></span></div>
        <nav class="story-steps" aria-label="Introduction chapters">{lines.map(([, phrase], index) => <button type="button" aria-label={`Go to ${phrase}`} aria-current={index === 0 ? "step" : undefined} data-step={index}><span></span></button>)}</nav>
      </div>
    </section>
    <ProductTour />
    <section class="download-section" id="download" aria-labelledby="download-title">
      <img src={icon.src} alt="" width="96" height="96" /><h2 id="download-title">Build with Khor</h2><p class="download-description">Start with the device in front of you</p>
      <ProductActions />
      <ProductInstallations prefix="download" />
    </section>
  </main>
  <footer class="story-footer"><a class="parent-brand" href="https://www.kapestack.top">kapestack</a><span>Khor · Work across your devices and agents</span><nav><a href={sitePath("/docs/")}>Docs</a><a href={REPO}>GitHub</a></nav></footer>

  <noscript><style>.story-nav{position:absolute}.canonical-icon{visibility:visible;filter:grayscale(1)}.opening{height:auto}.opening-sticky{position:relative;min-height:80svh}.opening-line{display:none}.opening-line:first-child{display:block;opacity:1}.story-steps,.scroll-cue{display:none}</style><p class="no-script">Enable JavaScript to view the animation. <a href={sitePath("/download/")}>Download Khor</a></p></noscript>
</Base>
<script>
  import { mountStory } from "../scripts/story";
  mountStory();
</script>
