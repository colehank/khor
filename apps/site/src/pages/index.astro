---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Mandala from "../components/Mandala.astro";
import ProductHero from "../components/ProductHero.astro";
import icon from "../../../gui/src-tauri/icons/src/mandala-glass.svg";
import { INSTALL, REPO } from "../site";
import { release } from "../releases";
import "../styles/story.css";
const lines = [["You have", "many devices."], ["With", "many harnesses."], ["But", "one mind."], ["How about", "letting them\nwork together?"], ["Meet", "Khor."]];
---
<Base description="连接各台设备上的智能体、网页与文件，从手边的设备继续工作">
  <a class="skip-story" href="#features">跳过开场</a>
  <header class="story-nav"><Mark /><nav aria-label="主导航"><a href="#features">功能</a><a href="/docs/">文档</a><a class="nav-download" href="#download">下载</a></nav></header>
  <main class="story-home">
    <ProductHero />
    <section class="opening" id="story" aria-label="认识 khor" data-opening>
      <div class="opening-sticky">
        <div class="meet-environment" data-meet-environment aria-hidden="true"></div>
        <div class="opening-copy" aria-hidden="true">{lines.map(([lead, phrase], index) => <p class:list={["opening-line", {"is-current": index === 0}]} data-line={index}><span class="line-lead">{lead}</span>{phrase.split("\n").map(text => <span class="line-phrase">{text}</span>)}</p>)}</div>
        <h2 class="sr-only">You have many devices. With many harnesses. But one mind. How about letting them work together? Meet Khor.</h2>
        <div class="assembly" data-assembly><Mandala /></div>
        <div class="scroll-cue" aria-hidden="true"><span>Scroll to connect</span><span class="scroll-stem"></span></div>
        <nav class="story-steps" aria-label="开场章节">{lines.map(([, phrase], index) => <button type="button" aria-label={`跳到 ${phrase}`} aria-current={index === 0 ? "step" : undefined} data-step={index}><span></span></button>)}</nav>
      </div>
    </section>
    <section class="resource-story" id="features" aria-labelledby="resources-title">
      <div class="resource-intro"><p class="eyebrow">From wherever you are.</p><h2 id="resources-title">设备上的工作，<br />手边接着做。</h2></div>
      <div class="resource-lines">
        <a href="/experience/app/index.html?scene=gui&amp;items=3&amp;machines=3&amp;theme=light"><span>智能体</span><p>查看进展、处理审批，让不同设备上的智能体协作</p><span aria-hidden="true">↗</span></a>
        <a href="/experience/app/index.html?scene=workspace&amp;items=3&amp;machines=3&amp;theme=light"><span>文件与 Git</span><p>打开远程项目，编辑文件，查看每一次变化</p><span aria-hidden="true">↗</span></a>
        <a href="/experience/app/index.html?scene=page&amp;items=3&amp;machines=3&amp;theme=light"><span>Web</span><p>从这台设备，访问另一台设备上的网页</p><span aria-hidden="true">↗</span></a>
        <a href="/docs/pair/"><span>你的设备网</span><p>通过点对点连接，把自己的设备连在一起</p><span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="download-section" id="download" aria-labelledby="download-title">
      <img src={icon.src} alt="" width="96" height="96" /><h2 id="download-title">从你的设备开始。</h2>
      <a class="download-main" href="/download/" data-device-download><span data-download-label>下载 Khor</span> <span aria-hidden="true">↓</span></a><a class="other-downloads" href="/download/">所有下载与安装方式</a>
      <div class="install-line"><code id="install">{INSTALL}</code><button type="button" data-copy="install">复制</button></div><p class="download-note">当前预览版 {release.version} · macOS App · Linux / macOS CLI</p>
    </section>
  </main>
  <footer class="story-footer"><Mark /><span>坛城（Kyil-khor），意为连接</span><nav><a href="/docs/">文档</a><a href={REPO}>GitHub</a></nav></footer>

  <noscript><style>.canonical-icon{visibility:visible;filter:grayscale(1)}.opening{height:auto}.opening-sticky{position:relative;min-height:80svh}.opening-line{display:none}.opening-line:first-child{display:block;opacity:1}.story-steps,.scroll-cue{display:none}</style><p class="no-script">开启 JavaScript 可观看动效。<a href="/download/">下载 khor</a></p></noscript>
</Base>
<script>
  import { mountStory } from "../scripts/story";
  mountStory();
</script>
