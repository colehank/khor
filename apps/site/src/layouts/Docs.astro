---
import {sitePath} from "../paths";
import Base from "./Base.astro";
import Mark from "../components/Mark.astro";
import SiteNav from "../components/SiteNav.astro";
import { docs } from "../site";
import '../styles/story.css';

interface Props {
  title: string;
  description?: string;
  /** The open page's id; absent on the overview. */
  current?: string;
}
const { title, description, current } = Astro.props;
const pages = await docs();
---

<Base title={title} description={description}>
  <SiteNav current="docs" />
  <div class="docs">
    <nav class="side" aria-label="Docs">
      <div class="side-in">
        <div class="side-head"><Mark /></div>
      <a class="nav-row" href={sitePath("/docs/")} aria-current={current ? undefined : "page"}>Overview</a>
      {
        pages.map((p) => (
          <a class="nav-row" href={sitePath(`/docs/${p.id}/`)} aria-current={p.id === current ? "page" : undefined}>
            {p.data.title}
          </a>
        ))
      }
      </div>
    </nav>
    <div class="main">
      <header class="r0">
        <div class="r0-title">
          {/* The way back exists only where the list is off screen. */}
          <a class="back" href={sitePath(current ? "/docs/" : "/")}>{current ? "Docs" : "khor"}</a>
          <h1>{title}</h1>
        </div>
      </header>
      <main class="board">
        <slot />
      </main>
    </div>
  </div>
</Base>
