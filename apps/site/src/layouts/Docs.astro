---
import Base from "./Base.astro";
import Mark from "../components/Mark.astro";
import { REPO, docs } from "../site";

interface Props {
  title: string;
  description?: string;
  /** The open page's id; absent on the overview. */
  current?: string;
}
const { title, description, current } = Astro.props;
const pages = await docs();
---

<Base title={title} description={description}>
  <div class="docs">
    <nav class="side" aria-label="文档">
      <div class="side-in">
        <div class="side-head"><Mark /></div>
      <a class="nav-row" href="/docs/" aria-current={current ? undefined : "page"}>总览</a>
      {
        pages.map((p) => (
          <a class="nav-row" href={`/docs/${p.id}/`} aria-current={p.id === current ? "page" : undefined}>
            {p.data.title}
          </a>
        ))
      }
      </div>
    </nav>
    <div class="main">
      <header class="r0">
        <div class="r0-title">
          {/* The way back exists only where the list is off screen. */}
          <a class="back" href={current ? "/docs/" : "/"}>{current ? "文档" : "khor"}</a>
          <h1>{title}</h1>
        </div>
        <a class="bar-link" href={REPO}>GitHub</a>
      </header>
      <main class="board">
        <slot />
      </main>
    </div>
  </div>
</Base>
