{
  "name": "khor-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "predev": "npm run tokens",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "npm run tokens",
    "build": "npm run demo:build && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "demo:build": "cd ../gui && vite build --config dev/site/vite.config.ts --outDir ../site/public/experience/app --emptyOutDir",
    "demo:check": "cd ../gui && tsc --noEmit --project dev/site/tsconfig.json"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
