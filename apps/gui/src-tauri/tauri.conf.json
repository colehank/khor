{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Khor",
  "version": "0.1.0",
  "identifier": "io.github.colehank.khor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Khor",
        "width": 1080,
        "height": 720,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
