{
  "name": "khor-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "mkdir -p src/gen && cargo run -q -p khor-catalog --bin gen_ts > src/gen/catalog.ts && cargo run -q -p khor-gui-core --bin gen_bindings",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run gen",
    "test": "node scripts/check-px.mjs && node scripts/check-icons.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "playwright-core": "^1.54",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
